# Copia de referencia de las variables que usa el backend (en Render se definen en el panel/render.yaml).
# Sin DATABASE_URL se usa SQLite en backend/sentinela.db.
DATABASE_URL=postgresql://usuario:password@host:5432/sentinela
DEVICE_API_KEY=dev-device-key
CORS_ORIGINS=*
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL=5
WEATHER_ENABLED=true
WEATHER_REFRESH_HOURS=6
DGE_ETL_ENABLED=false
EPIDEMIC_THRESHOLD=150
ERP_NAME=ERP institucional SSY (simulado)
